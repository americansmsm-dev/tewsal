{
  "name": "tewsal",
  "version": "0.1.0",
  "private": true,
  "description": "نظام إدارة الشحنات — توصّل / TEWSAL",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/server/jobs/worker.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "invariants": "tsx scripts/invariants.ts",
    "verify:ledger": "tsx scripts/verify-ledger.ts",
    "verify:transition": "tsx scripts/verify-transition.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "verify:shipment-api": "tsx scripts/verify-shipment-api.ts",
    "verify:settlement-api": "tsx scripts/verify-settlement-api.ts",
    "reset-admin": "tsx scripts/reset-admin.ts",
    "db:migrate:prod": "node --experimental-strip-types scripts/migrate.ts"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "zod": "^3.24.1",
    "@node-rs/argon2": "^2.0.2",
    "uuid": "^11.0.5",
    "bwip-js": "^4.5.1",
    "exceljs": "^4.4.0",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "@aws-sdk/client-s3": "^3.723.0",
    "@aws-sdk/s3-request-presigner": "^3.723.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.11.2",
    "lucide-react": "^0.469.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.2",
    "vitest": "^2.1.8",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
