# ============================================================
#  متغيرات بيئة الإنتاج — Tewsal
#  انسخ ده في Coolify (Environment Variables) — مش في git.
#  ⚠️ ولّد كل سر بأمر:  openssl rand -base64 32
# ============================================================

# قاعدة البيانات — من مورد Postgres في Coolify (الشبكة الداخلية)
DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/tewsal

# أسرار — ولّدهم عشوائيًا وميتغيّروش بعد كده
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# رابط التطبيق العام
APP_URL=https://app.tewsal.online
NODE_ENV=production

# --- اختياري (لما نفعّل الوحدات دي) ---
# تخزين صور الإثبات — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tewsal
# إشعارات واتساب — WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# تليجرام — النسخ الاحتياطية وتنبيهات التشغيل
# البوت من @BotFather، والقناة لازم البوت يكون مشرف فيها
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# النسخ الاحتياطي (كل ١٢ ساعة) — ٢٨ نسخة = ١٤ يوم
BACKUP_DIR=/backups
BACKUP_RETAIN=28

# ============================================================
#  القدرة — حوض الاتصالات والمهلات
# ------------------------------------------------------------
#  المهلات بتتبعت كبارامترات بدء الاتصال، فبتتطبّق على
#  التطبيق بس — السكربتات (هجرات · باك أب) ماتتأثرش.
# ============================================================
DB_POOL_MAX=20
# أقصى وقت لاستعلام واحد (ms) — استعلام أطول من كده = مشكلة
DB_STATEMENT_TIMEOUT_MS=30000
# أقصى انتظار على قفل صف (ms) — أحسن يفشل بسرعة من إنه يعلّق
DB_LOCK_TIMEOUT_MS=10000
# ترانزاكشن سايبة مفتوحة (ms) — بتقفل قفل من غير شغل
DB_IDLE_TX_TIMEOUT_MS=60000
# حوض منفصل للتقارير الثقيلة — تقرير واحد مايقدرش ياخد اتصالات
# الشغل اليومي. (قياس الحمل: من غيره الجدول بيرد في ٦ ثواني
# بدل ٢١ms وهو مستني في الطابور بس.)
DB_REPORT_POOL_MAX=4
DB_REPORT_STATEMENT_TIMEOUT_MS=60000

# حجم دفعة الاستيراد المجمّع (صف/ترانزاكشن)
IMPORT_CHUNK_SIZE=100

# --- PgBouncer (لما يتركّب) ---
# PGBOUNCER=1 بيقفل الـ prepared statements (شرط وضع تجميع الترانزاكشن).
# ولازم في pgbouncer.ini:
#   pool_mode = transaction
#   track_extra_parameters = statement_timeout,lock_timeout,idle_in_transaction_session_timeout
# لو PgBouncer أقدم من 1.21 حط DB_STARTUP_TIMEOUTS=0 وظبّط المهلات
# على الدور نفسه:  ALTER ROLE tewsal_app SET statement_timeout = '30s';
#PGBOUNCER=1
#DB_STARTUP_TIMEOUTS=0

# ============================================================
#  إشعارات الجهاز (Web Push) — فون · لاب · تاب
# ------------------------------------------------------------
#  ولّدهم مرة واحدة بـ:  npm run vapid
#  ⚠️ المفتاح الخاص **سر** — إنت اللي بتحطه في Coolify.
#  ⚠️ لو غيّرتهم بعد ما ناس اشتركت، كل الاشتراكات القديمة بتبطل
#     ولازم الناس تفعّل الإشعارات تاني.
#  من غير المفاتيح دي: الإشعارات جوّه السيستم شغّالة عادي،
#  وإشعارات الجهاز بس هي اللي بتبقى متعطّلة.
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tewsal.online
