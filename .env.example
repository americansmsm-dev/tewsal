# ============================================================
#  متغيرات البيئة — نسخة للتطوير المحلي
#  انسخه لـ .env.local وعدّل القيم. ⚠️ متحطش أسرار حقيقية هنا.
#  للإنتاج شوف .env.production.example (والقيم بتتحط في Coolify).
# ============================================================

# قاعدة البيانات المحلية
DATABASE_URL=postgres://postgres@127.0.0.1:54320/tewsal

# أسرار محلية — ولّدهم بـ: openssl rand -base64 32
SESSION_SECRET=dev-secret-please-change-me-32chars-min
ENCRYPTION_KEY=dev-encryption-key-change-me-32chars

APP_URL=http://localhost:3000
NODE_ENV=development

# --- اختياري: الوحدات الخارجية (سيبها فاضية للتطوير) ---
# تخزين صور الإثبات والنسخ الخارجية — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tewsal

# إشعارات العملاء — WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# النسخ الاحتياطية وتنبيهات التشغيل — Telegram
# البوت من @BotFather، والبوت لازم يكون مشرف في القناة
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# النسخ الاحتياطي
BACKUP_DIR=./backups
BACKUP_RETAIN=28

# حجم حوض اتصالات قاعدة البيانات
DB_POOL_MAX=10
