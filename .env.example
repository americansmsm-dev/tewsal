# ============================================================
#  متغيرات البيئة — نسخة للتطوير المحلي
#  انسخه لـ .env.local وعدّل القيم. ⚠️ متحطش أسرار حقيقية هنا.
#  للإنتاج شوف .env.production.example (والقيم بتتحط في Coolify).
# ============================================================

# قاعدة البيانات المحلية
DATABASE_URL=postgres://postgres@127.0.0.1:54320/tewsal

# أسرار محلية — ولّدهم بـ: openssl rand -base64 32
SESSION_SECRET=dev-secret-please-change-me-32chars-min
ENCRYPTION_KEY=dev-encryption-key-change-me-32chars

APP_URL=http://localhost:3000
NODE_ENV=development

# --- اختياري: الوحدات الخارجية (سيبها فاضية للتطوير) ---
# تخزين صور الإثبات والنسخ الخارجية — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tewsal

# إشعارات العملاء — WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# النسخ الاحتياطية وتنبيهات التشغيل — Telegram
# البوت من @BotFather، والبوت لازم يكون مشرف في القناة
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# النسخ الاحتياطي
BACKUP_DIR=./backups
BACKUP_RETAIN=28

# ============================================================
#  القدرة — حوض الاتصالات والمهلات
# ------------------------------------------------------------
#  المهلات بتتبعت كبارامترات بدء الاتصال، فبتتطبّق على
#  التطبيق بس — السكربتات (هجرات · باك أب) ماتتأثرش.
# ============================================================
DB_POOL_MAX=20
# أقصى وقت لاستعلام واحد (ms) — استعلام أطول من كده = مشكلة
DB_STATEMENT_TIMEOUT_MS=30000
# أقصى انتظار على قفل صف (ms) — أحسن يفشل بسرعة من إنه يعلّق
DB_LOCK_TIMEOUT_MS=10000
# ترانزاكشن سايبة مفتوحة (ms) — بتقفل قفل من غير شغل
DB_IDLE_TX_TIMEOUT_MS=60000
# حجم دفعة الاستيراد المجمّع (صف/ترانزاكشن)
IMPORT_CHUNK_SIZE=100

# --- PgBouncer (لما يتركّب) ---
# PGBOUNCER=1 بيقفل الـ prepared statements (شرط وضع تجميع الترانزاكشن).
# ولازم في pgbouncer.ini:
#   pool_mode = transaction
#   track_extra_parameters = statement_timeout,lock_timeout,idle_in_transaction_session_timeout
# لو PgBouncer أقدم من 1.21 حط DB_STARTUP_TIMEOUTS=0 وظبّط المهلات
# على الدور نفسه:  ALTER ROLE tewsal_app SET statement_timeout = '30s';
#PGBOUNCER=1
#DB_STARTUP_TIMEOUTS=0
